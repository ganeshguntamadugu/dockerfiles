FROM almalinux
# FROM instruction is the first instruction in Dockerfile. It represents base OS.

# CMD [ "ping", "google.com" ]
# CMD instruction runs at the time of container creation. CMD can be overridden at runtime

# ENTRYPOINT [ "ping", "google.com" ]
# You can't override ENTRYPOINT like CMD. If you try to do it will go and append to the entrypoint command

CMD [ "google.com" ]
ENTRYPOINT [ "ping" ]